<Project>
  <PropertyGroup>
    <NithRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</NithRepositoryRoot>
    <ApplicationIcon>Assets\Generated\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Generated\logo-16.png;Assets\Generated\logo-20.png;Assets\Generated\logo-24.png;Assets\Generated\logo-32.png;Assets\Generated\logo-40.png;Assets\Generated\logo-48.png;Assets\Generated\logo-64.png;Assets\Generated\logo-128.png;Assets\Generated\logo-256.png;Assets\Generated\logo-512.png;Assets\Generated\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="GenerateNithIdentity" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Generate-Assets.ps1&quot; -ProjectRoot &quot;$(NithRepositoryRoot).&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\Assets\Generated&quot;" />
  </Target>
</Project>
