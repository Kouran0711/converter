<UserControl x:Class="NithConverter.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="20" HorizontalAlignment="Stretch" Padding="0,0,4,12">
      <StackPanel Spacing="6">
        <TextBlock Text="Configurações" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Conversão, atualizações e comportamento do aplicativo." Foreground="{StaticResource MutedForeground}"/>
      </StackPanel>

      <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
        <TextBlock Text="ARQUIVOS E DESTINO" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="Pasta padrão de saída" FontWeight="SemiBold"/>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Settings.DefaultOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Vazio = mesma pasta do original" AutomationProperties.Name="Pasta padrão de saída"/>
          <Button Grid.Column="1" Command="{Binding Settings.BrowseCommand}" Content="Escolher"/>
        </Grid>
        <ToggleSwitch Header="Abrir pasta após a conversão" IsOn="{Binding Settings.OpenFolderAfterConversion, Mode=TwoWay}" OnContent="Ativado" OffContent="Desativado"/>
        <ToggleSwitch Header="Confirmar substituição" IsOn="{Binding Settings.ConfirmOverwrite, Mode=TwoWay}" OnContent="Perguntar antes de substituir" OffContent="Preservar arquivos existentes"/>
        <TextBlock Text="Sem confirmação, a conversão para se o destino já existir. O arquivo original é sempre preservado." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
      </StackPanel></Border>

      <Border Style="{StaticResource Card}"><StackPanel Spacing="15">
        <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource SectionLabel}"/>
        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="10" Background="#162B3B"><FontIcon Glyph="&#xE895;" FontSize="21" Foreground="#66BCFF"/></Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="GitHub Releases" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding AppVersionText}" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
          </StackPanel>
        </Grid>
        <ToggleSwitch Header="Verificar ao abrir o aplicativo" IsOn="{Binding Settings.CheckForUpdatesOnStartup, Mode=TwoWay}" OnContent="Ativado" OffContent="Desativado"/>
        <ToggleSwitch Header="Baixar novas versões automaticamente" IsOn="{Binding Settings.AutoDownloadUpdates, Mode=TwoWay}" OnContent="Baixar em segundo plano" OffContent="Perguntar antes de baixar"/>
        <Border Background="#101A23" CornerRadius="8" Padding="12">
          <StackPanel Spacing="4"><TextBlock Text="{Binding UpdateStatus}" FontWeight="SemiBold"/><TextBlock Text="{Binding UpdateDetail}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForeground}"/></StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Verificar agora" Command="{Binding CheckUpdatesCommand}"/>
          <Button Content="{Binding UpdateActionText}" Command="{Binding UpdateActionCommand}" Visibility="{Binding UpdateActionVisibility}" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
        <TextBlock Text="Quando uma versão nova é encontrada, o instalador oficial é baixado e validado por SHA-256. A instalação pede permissão de administrador do Windows." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedForeground}"/>
      </StackPanel></Border>

      <Border Style="{StaticResource Card}"><StackPanel Spacing="15">
        <TextBlock Text="MECANISMOS DE CONVERSÃO" Style="{StaticResource SectionLabel}"/>
        <Grid ColumnSpacing="18" RowSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="#0A1727" CornerRadius="10" Padding="14">
            <StackPanel Spacing="4"><TextBlock Text="ImageMagick" FontWeight="SemiBold"/><TextBlock Text="{Binding ImageMagickStatus}" Foreground="{StaticResource MutedForeground}"/></StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#0A1727" CornerRadius="10" Padding="14">
            <StackPanel Spacing="4"><TextBlock Text="FFmpeg + FFprobe" FontWeight="SemiBold"/><TextBlock Text="{Binding FFmpegStatus}" Foreground="{StaticResource MutedForeground}"/></StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0A1727" CornerRadius="10" Padding="14">
            <StackPanel Spacing="4"><TextBlock Text="Documentos PDF / PS / EPS" FontWeight="SemiBold"/><TextBlock Text="{Binding PdfStatus}" Foreground="{StaticResource MutedForeground}"/></StackPanel>
          </Border>
        </Grid>
        <TextBlock Text="Esses componentes fazem parte do instalador do NITH Converter. Você não precisa baixar ou instalar nada separadamente." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
      </StackPanel></Border>

      <Border Style="{StaticResource Card}"><StackPanel Spacing="14">
        <TextBlock Text="SALVAR CONFIGURAÇÕES" Style="{StaticResource SectionLabel}"/>
        <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Salvar configurações" Command="{Binding Settings.SaveCommand}" Style="{StaticResource AccentButtonStyle}"/><TextBlock Text="{Binding Settings.SaveStatus}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Foreground="{StaticResource MutedForeground}"/></StackPanel>
      </StackPanel></Border>

      <StackPanel Spacing="3" HorizontalAlignment="Center">
        <TextBlock Text="{Binding ProductVersionText}" FontSize="12" Foreground="{StaticResource MutedForeground}" HorizontalAlignment="Center"/>
        <HyperlinkButton Content="Nith Digital - nithdigital.com.br" NavigateUri="https://nithdigital.com.br" HorizontalAlignment="Center" FontSize="12"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
