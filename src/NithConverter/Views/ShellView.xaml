<UserControl x:Class="NithConverter.Views.ShellView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:NithConverter.Views" RequestedTheme="Dark">
  <Grid Background="{StaticResource AppBackground}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="54"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0A1220" BorderBrush="#18528B" BorderThickness="0,0,0,1">
      <Grid x:Name="TitleBar" Padding="18,0,140,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="ms-appx:///Assets/Generated/logo-48.png" Width="28" Height="28"/>
          <TextBlock Text="NITH Converter" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <NavigationView x:Name="Navigation"
                    Grid.Row="1"
                    Background="Transparent"
                    PaneDisplayMode="Left"
                    OpenPaneLength="222"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    IsPaneToggleButtonVisible="False"
                    CompactModeThresholdWidth="0"
                    ExpandedModeThresholdWidth="0"
                    SelectionChanged="OnNavigationChanged"
                    PaneClosing="OnPaneClosing"
                    IsPaneOpen="True"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
      <NavigationView.PaneHeader>
        <StackPanel Margin="12,18,12,20" Spacing="14">
          <Image Source="ms-appx:///Assets/Generated/logo-256.png" Width="108" Height="108" HorizontalAlignment="Left"/>
          <StackPanel Spacing="2">
            <TextBlock Text="NITH" FontSize="20" FontWeight="Bold" CharacterSpacing="190" />
            <TextBlock Text="CONVERTER" FontSize="9" CharacterSpacing="220" Foreground="{StaticResource MutedForeground}" />
          </StackPanel>
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="ConvertItem" Content="Converter" Tag="convert" IsSelected="True">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Histórico" Tag="history">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="16,10,16,18" Spacing="8">
          <TextBlock Text="LOCAL. SIMPLES. NATIVO." FontSize="9" CharacterSpacing="80" Foreground="{StaticResource MutedForeground}"/>
          <TextBlock Text="{Binding AppVersionText}" FontSize="11" Foreground="White"/>
          <TextBlock Text="Nith Digital" FontSize="10" Foreground="#8AB4D8"/>
        </StackPanel>
      </NavigationView.PaneFooter>
      <Grid x:Name="ContentViewport" Margin="24,18,24,18" HorizontalAlignment="Stretch">
        <Grid Width="{Binding ActualWidth, ElementName=ContentViewport}" MaxWidth="1460" HorizontalAlignment="Center">
          <views:ConverterPage x:Name="ConverterPage"/>
          <views:HistoryPage x:Name="HistoryPage" Visibility="Collapsed"/>
          <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</UserControl>
