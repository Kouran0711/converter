<UserControl x:Class="NithConverter.Views.ShellView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:NithConverter.Views" RequestedTheme="Dark">
  <Grid Background="{StaticResource AppBackground}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Padding="18,0,140,0" Background="#151A21">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Generated/logo-48.png" Width="30" Height="30"/>
        <TextBlock Text="NITH Converter" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="210" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" IsPaneToggleButtonVisible="False" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0" SelectionChanged="OnNavigationChanged" PaneClosing="OnPaneClosing" IsPaneOpen="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <NavigationView.PaneHeader>
        <StackPanel Margin="20,20,0,24" Spacing="3">
          <TextBlock Text="NITH" FontSize="22" FontWeight="Bold" CharacterSpacing="200" />
          <TextBlock Text="CONVERTER" FontSize="10" CharacterSpacing="200" Foreground="{StaticResource MutedForeground}" />
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="ConvertItem" Content="Converter" Tag="convert" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Histórico" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="20,16" Spacing="6"><TextBlock Text="LOCAL. SIMPLES. NATIVO." FontSize="9" CharacterSpacing="80" Foreground="{StaticResource MutedForeground}"/><TextBlock Text="{Binding AppVersionText}" FontSize="11" Foreground="{StaticResource MutedForeground}"/><TextBlock Text="Nith Digital" FontSize="10" Foreground="#6E8297"/></StackPanel>
      </NavigationView.PaneFooter>
      <Grid x:Name="ContentViewport" Margin="30,24,30,20" HorizontalAlignment="Stretch">
        <Grid Width="{Binding ActualWidth, ElementName=ContentViewport}" MaxWidth="860" HorizontalAlignment="Center">
        <views:ConverterPage x:Name="ConverterPage"/>
        <views:HistoryPage x:Name="HistoryPage" Visibility="Collapsed"/>
        <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</UserControl>
