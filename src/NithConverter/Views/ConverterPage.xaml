<UserControl x:Class="NithConverter.Views.ConverterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="18" Padding="0,0,0,8">
      <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{Binding UpdateStatus}" Message="{Binding UpdateDetail}" Visibility="{Binding UpdateBannerVisibility}">
        <InfoBar.ActionButton>
          <Button Content="{Binding UpdateActionText}" Command="{Binding UpdateActionCommand}" Visibility="{Binding UpdateActionVisibility}" Style="{StaticResource AccentButtonStyle}"/>
        </InfoBar.ActionButton>
      </InfoBar>

      <Grid ColumnSpacing="22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.2*"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="18">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
              <TextBlock Text="Converter arquivos" FontSize="44" FontWeight="SemiBold"/>
              <TextBlock Text="Imagens, documentos, vídeos e áudio com controle de qualidade." Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" FontSize="16"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#0F2743" BorderBrush="#1F7DFF" BorderThickness="1" CornerRadius="18" Padding="18,10" VerticalAlignment="Center">
              <TextBlock Text="IMAGENS · PDF · VÍDEOS · ÁUDIO" Foreground="#73CFFF" FontSize="11" CharacterSpacing="90"/>
            </Border>
          </Grid>

          <Border Style="{StaticResource Card}" Padding="18">
            <Grid ColumnSpacing="18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" CornerRadius="18" BorderBrush="#1F78C5" BorderThickness="1" Background="#0B1B31" Padding="22,24">
                <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <FontIcon Glyph="&#xE898;" FontSize="62" Foreground="#31D8FF" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding FileName}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FilePath}"/>
                  <TextBlock Text="{Binding FileDescription}" Foreground="{StaticResource MutedForeground}" FontSize="15" TextAlignment="Center" TextWrapping="WrapWholeWords"/>
                  <Button Content="Escolher arquivo" Command="{Binding ChooseFileCommand}" Padding="28,12" MinWidth="260" HorizontalAlignment="Center" AutomationProperties.AutomationId="ChooseFileButton" Style="{StaticResource AccentButtonStyle}"/>
                  <TextBlock Text="Você também pode arrastar um arquivo para qualquer lugar da janela." Foreground="#7F97AF" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Background="#091521" CornerRadius="16" BorderBrush="#153A63" BorderThickness="1" Padding="16">
                <StackPanel Spacing="14">
                  <TextBlock Text="Formatos suportados" FontSize="14" FontWeight="SemiBold"/>
                  <StackPanel Spacing="11">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <FontIcon Glyph="&#xE91B;" Foreground="#46C7FF" FontSize="18"/>
                      <StackPanel>
                        <TextBlock Text="Imagens" FontWeight="SemiBold"/>
                        <TextBlock Text="JPG, PNG, WEBP, BMP, TIFF" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <FontIcon Glyph="&#xE8A5;" Foreground="#3AEBA8" FontSize="18"/>
                      <StackPanel>
                        <TextBlock Text="Documentos" FontWeight="SemiBold"/>
                        <TextBlock Text="PDF, PS, EPS e texto" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <FontIcon Glyph="&#xE714;" Foreground="#9E66FF" FontSize="18"/>
                      <StackPanel>
                        <TextBlock Text="Vídeos" FontWeight="SemiBold"/>
                        <TextBlock Text="MP4, MKV, AVI, MOV, WMV" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <FontIcon Glyph="&#xE189;" Foreground="#FFB347" FontSize="18"/>
                      <StackPanel>
                        <TextBlock Text="Áudio" FontWeight="SemiBold"/>
                        <TextBlock Text="MP3, WAV, M4A, AAC, FLAC" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8A5;" Foreground="#46C7FF" FontSize="20"/>
                <TextBlock Text="Arquivo de saída" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>

              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.2*"/>
                  <ColumnDefinition Width="2.4*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="7">
                  <TextBlock Text="Formato de saída" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                  <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" DisplayMemberPath="DisplayName" PlaceholderText="Selecione um formato" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Formato de saída" AutomationProperties.AutomationId="OutputFormatComboBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="7">
                  <TextBlock Text="Nome do arquivo" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OutputBaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nome sem a extensão" IsEnabled="{Binding CanRename}" MaxLength="240" AutomationProperties.Name="Nome do arquivo de saída" AutomationProperties.AutomationId="OutputNameTextBox"/>
                    <TextBlock Grid.Column="1" Text="{Binding OutputExtension}" VerticalAlignment="Center" Foreground="{StaticResource MutedForeground}"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding OutputNameError}" Visibility="{Binding OutputNameErrorVisibility}" TextWrapping="Wrap" Foreground="#FFB4AB" FontSize="12"/>

              <StackPanel Spacing="7">
                <TextBlock Text="Pasta de destino" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button Command="{Binding ChooseDestinationCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="{Binding DestinationLabel}" AutomationProperties.Name="Escolher pasta de destino">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <FontIcon Glyph="&#xE838;" FontSize="16" VerticalAlignment="Center" Foreground="#8ACFFF"/>
                      <TextBlock Grid.Column="1" Text="{Binding DestinationLabel}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Command="{Binding ResetDestinationCommand}" ToolTipService.ToolTip="Usar pasta padrão" AutomationProperties.Name="Usar pasta padrão"><FontIcon Glyph="&#xE777;" FontSize="14"/></Button>
                </Grid>
              </StackPanel>

              <TextBlock Text="{Binding ConversionHint}" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
          </Border>

          <StackPanel Spacing="10">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button Content="Converter arquivo" Command="{Binding ConvertCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="56" FontWeight="SemiBold" AutomationProperties.AutomationId="ConvertButton"/>
              <Button Grid.Column="1" Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding BusyVisibility}" Height="56" Padding="22,8" AutomationProperties.AutomationId="CancelButton"/>
            </Grid>
            <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Visibility="{Binding BusyVisibility}" Maximum="100" Height="5" AutomationProperties.Name="Progresso da conversão"/>
            <InfoBar IsOpen="True" IsClosable="False" Severity="{Binding Severity}" Title="{Binding Status}" Message="{Binding StatusDetail}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Abrir pasta de destino" Command="{Binding OpenOutputCommand}" Visibility="{Binding OutputVisibility}"/>
              <HyperlinkButton Content="Detalhes técnicos" Command="{Binding DetailsCommand}" Visibility="{Binding DetailsVisibility}"/>
            </StackPanel>
            <TextBlock Text="{Binding DependencyStatus}" FontSize="11" Foreground="{StaticResource MutedForeground}"/>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <FontIcon Glyph="&#xE713;" Foreground="#46C7FF" FontSize="20"/>
              <TextBlock Text="Opções de conversão" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>

            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ToggleButton Content="Atualização" IsChecked="True" IsEnabled="False"/>
              <ToggleButton Grid.Column="1" Content="Qualidade" IsChecked="True" IsEnabled="False"/>
            </Grid>

            <Border Background="#091521" CornerRadius="12" Padding="12" Visibility="{Binding UpdateBannerVisibility}">
              <StackPanel Spacing="6">
                <TextBlock Text="Atualizações" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="White"/>
                <TextBlock Text="{Binding UpdateDetail}" FontSize="12" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <StackPanel Spacing="7" Visibility="{Binding Options.VisualResizeVisibility}">
              <TextBlock Text="Redimensionar (imagens e vídeos)" FontWeight="SemiBold" FontSize="13"/>
              <ComboBox ItemsSource="{Binding Options.WidthChoices}" SelectedItem="{Binding Options.SelectedWidth, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Largura máxima" AutomationProperties.AutomationId="MaxWidthComboBox"/>
            </StackPanel>

            <StackPanel Spacing="7" Visibility="{Binding Options.DocumentVisibility}">
              <TextBlock Text="Resolução do documento" FontWeight="SemiBold" FontSize="13"/>
              <ComboBox ItemsSource="{Binding Options.DocumentDpiChoices}" SelectedItem="{Binding Options.SelectedDocumentDpi, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="DPI do documento"/>
            </StackPanel>

            <Grid ColumnSpacing="14" Visibility="{Binding Options.VideoVisibility}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="7">
                <TextBlock Text="Qualidade do vídeo" FontWeight="SemiBold" FontSize="13" Visibility="{Binding Options.VideoQualityVisibility}"/>
                <ComboBox ItemsSource="{Binding Options.QualityChoices}" SelectedItem="{Binding Options.SelectedVideoQuality, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Visibility="{Binding Options.VideoQualityVisibility}" AutomationProperties.Name="Qualidade do vídeo" AutomationProperties.AutomationId="VideoQualityComboBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Text="Quadros por segundo" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.FpsChoices}" SelectedItem="{Binding Options.SelectedFps, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Quadros por segundo" AutomationProperties.AutomationId="FpsComboBox"/>
              </StackPanel>
            </Grid>

            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="7" Visibility="{Binding Options.PngVisibility}">
                <TextBlock Text="Compressão PNG" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.CompressionChoices}" SelectedItem="{Binding Options.SelectedCompression, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Compressão PNG" AutomationProperties.AutomationId="PngCompressionComboBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7" Visibility="{Binding Options.GifVisibility}">
                <TextBlock Text="Cores do GIF" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.ColorChoices}" SelectedItem="{Binding Options.SelectedColors, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Cores do GIF" AutomationProperties.AutomationId="GifColorsComboBox"/>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="6" Visibility="{Binding Options.ImageQualityVisibility}">
              <Grid>
                <TextBlock Text="Qualidade da imagem" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding Options.ImageQualityLabel}" HorizontalAlignment="Right" Foreground="#8ACFFF"/>
              </Grid>
              <Slider Value="{Binding Options.ImageQuality, Mode=TwoWay}" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" AutomationProperties.Name="Qualidade da imagem" AutomationProperties.AutomationId="ImageQualitySlider"/>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{Binding Options.AudioOptionsVisibility}">
              <TextBlock Text="Opções de áudio" FontWeight="SemiBold" FontSize="13"/>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="7" Visibility="{Binding Options.AudioBitrateVisibility}">
                  <TextBlock Text="Bitrate" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                  <ComboBox ItemsSource="{Binding Options.AudioBitrateChoices}" SelectedItem="{Binding Options.SelectedAudioBitrate, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Bitrate de áudio"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="7">
                  <TextBlock Text="Taxa de amostragem" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                  <ComboBox ItemsSource="{Binding Options.AudioSampleRateChoices}" SelectedItem="{Binding Options.SelectedAudioSampleRate, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Taxa de amostragem"/>
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="7">
                  <TextBlock Text="Canais" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                  <ComboBox ItemsSource="{Binding Options.AudioChannelChoices}" SelectedItem="{Binding Options.SelectedAudioChannels, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Canais de áudio"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="7">
                  <TextBlock Text="Áudio do vídeo" FontSize="12" Foreground="{StaticResource MutedForeground}" Visibility="{Binding Options.KeepAudioVisibility}"/>
                  <ToggleSwitch IsOn="{Binding Options.KeepAudio, Mode=TwoWay}" OnContent="Manter" OffContent="Remover" Visibility="{Binding Options.KeepAudioVisibility}" AutomationProperties.AutomationId="KeepAudioToggle"/>
                </StackPanel>
              </Grid>
            </StackPanel>

            <Border Background="#091521" CornerRadius="12" Padding="12">
              <TextBlock Text="{Binding Options.Hint}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Salvar como padrão" Command="{Binding SaveOptionsCommand}" AutomationProperties.AutomationId="SaveOptionsButton"/>
              <Button Content="Restaurar ajustes" Command="{Binding ResetOptionsCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding OptionsStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedForeground}"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
