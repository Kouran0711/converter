<UserControl x:Class="NithConverter.Views.ConverterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="5">
        <TextBlock Text="Converter arquivos" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Imagens, documentos e vídeos com controle de qualidade." Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#162B3B" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
        <TextBlock Text="{Binding Options.ContextLabel}" Foreground="#8ACFFF" FontSize="10" CharacterSpacing="90"/>
      </Border>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="16" Padding="0,0,4,8">
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{Binding UpdateStatus}" Message="{Binding UpdateDetail}" Visibility="{Binding UpdateBannerVisibility}">
          <InfoBar.ActionButton>
            <Button Content="{Binding UpdateActionText}" Command="{Binding UpdateActionCommand}" Visibility="{Binding UpdateActionVisibility}" Style="{StaticResource AccentButtonStyle}"/>
          </InfoBar.ActionButton>
        </InfoBar>

        <Border Style="{StaticResource Card}" Padding="20" MinHeight="110" BorderBrush="#365B75">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="50" Height="50" Background="#162B3B" CornerRadius="12" VerticalAlignment="Center"><FontIcon Glyph="&#xE8E5;" Foreground="#66BCFF" FontSize="24"/></Border>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FilePath}"/>
              <TextBlock Text="{Binding FileDescription}" Foreground="{StaticResource MutedForeground}" FontSize="12" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Você também pode arrastar um arquivo para qualquer lugar da janela." Foreground="#738397" FontSize="11"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Escolher arquivo" Command="{Binding ChooseFileCommand}" VerticalAlignment="Center" Padding="16,10" AutomationProperties.AutomationId="ChooseFileButton"/>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20">
          <StackPanel Spacing="15">
            <TextBlock Text="ARQUIVO DE SAÍDA" Style="{StaticResource SectionLabel}"/>
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="7">
                <TextBlock Text="Formato" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" DisplayMemberPath="DisplayName" PlaceholderText="Selecione um arquivo" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Formato de saída" AutomationProperties.AutomationId="OutputFormatComboBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Text="Nome do arquivo" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding OutputBaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nome sem a extensão" IsEnabled="{Binding CanRename}" MaxLength="240" AutomationProperties.Name="Nome do arquivo de saída" AutomationProperties.AutomationId="OutputNameTextBox"/>
                  <TextBlock Grid.Column="1" Text="{Binding OutputExtension}" VerticalAlignment="Center" Foreground="{StaticResource MutedForeground}"/>
                </Grid>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding OutputNameError}" Visibility="{Binding OutputNameErrorVisibility}" TextWrapping="Wrap" Foreground="#FFB4AB" FontSize="12"/>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button Command="{Binding ChooseDestinationCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="{Binding DestinationLabel}" AutomationProperties.Name="Escolher pasta de destino">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE838;" FontSize="16" VerticalAlignment="Center" Foreground="#8ACFFF"/><TextBlock Grid.Column="1" Text="{Binding DestinationLabel}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Button>
              <Button Grid.Column="1" Command="{Binding ResetDestinationCommand}" ToolTipService.ToolTip="Usar pasta padrão" AutomationProperties.Name="Usar pasta padrão"><FontIcon Glyph="&#xE777;" FontSize="14"/></Button>
            </Grid>
          </StackPanel>
        </Border>

        <Expander Header="Qualidade e ajustes avançados" IsExpanded="True" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{Binding Options.AvailableVisibility}" AutomationProperties.AutomationId="ConversionOptionsExpander">
          <StackPanel Spacing="16">
            <Grid ColumnSpacing="18">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="7" Visibility="{Binding Options.VisualResizeVisibility}">
                <TextBlock Text="Resolução / largura máxima" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.WidthChoices}" SelectedItem="{Binding Options.SelectedWidth, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Largura máxima" AutomationProperties.AutomationId="MaxWidthComboBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7" Visibility="{Binding Options.VideoQualityVisibility}">
                <TextBlock Text="Qualidade do vídeo" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.QualityChoices}" SelectedItem="{Binding Options.SelectedVideoQuality, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Qualidade do vídeo" AutomationProperties.AutomationId="VideoQualityComboBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7" Visibility="{Binding Options.PngVisibility}">
                <TextBlock Text="Compressão PNG" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.CompressionChoices}" SelectedItem="{Binding Options.SelectedCompression, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Compressão PNG" AutomationProperties.AutomationId="PngCompressionComboBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7" Visibility="{Binding Options.GifVisibility}">
                <TextBlock Text="Cores do GIF" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.ColorChoices}" SelectedItem="{Binding Options.SelectedColors, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Cores do GIF" AutomationProperties.AutomationId="GifColorsComboBox"/>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="7" Visibility="{Binding Options.DocumentVisibility}">
              <TextBlock Text="Resolução do documento" FontWeight="SemiBold" FontSize="13"/>
              <ComboBox ItemsSource="{Binding Options.DocumentDpiChoices}" SelectedItem="{Binding Options.SelectedDocumentDpi, Mode=TwoWay}" DisplayMemberPath="Label" MaxWidth="420" HorizontalAlignment="Left" MinWidth="280" AutomationProperties.Name="DPI do documento"/>
            </StackPanel>

            <StackPanel Spacing="5" Visibility="{Binding Options.ImageQualityVisibility}">
              <Grid><TextBlock Text="Qualidade da imagem" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Options.ImageQualityLabel}" HorizontalAlignment="Right" Foreground="#8ACFFF"/></Grid>
              <Slider Value="{Binding Options.ImageQuality, Mode=TwoWay}" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" AutomationProperties.Name="Qualidade da imagem" AutomationProperties.AutomationId="ImageQualitySlider"/>
            </StackPanel>

            <Grid ColumnSpacing="18" Visibility="{Binding Options.VideoVisibility}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="7"><TextBlock Text="Quadros por segundo (FPS)" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Options.FpsChoices}" SelectedItem="{Binding Options.SelectedFps, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Quadros por segundo" AutomationProperties.AutomationId="FpsComboBox"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" Header="Áudio" IsOn="{Binding Options.KeepAudio, Mode=TwoWay}" OnContent="Manter" OffContent="Remover" Visibility="{Binding Options.KeepAudioVisibility}" AutomationProperties.AutomationId="KeepAudioToggle"/>
            </Grid>

            <StackPanel Spacing="12" Visibility="{Binding Options.AudioOptionsVisibility}">
              <TextBlock Text="Ajustes de áudio" FontWeight="SemiBold" FontSize="13"/>
              <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="7" Visibility="{Binding Options.AudioBitrateVisibility}">
                  <TextBlock Text="Bitrate / qualidade" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                  <ComboBox ItemsSource="{Binding Options.AudioBitrateChoices}" SelectedItem="{Binding Options.SelectedAudioBitrate, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Bitrate de áudio"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="7">
                  <TextBlock Text="Taxa de amostragem" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                  <ComboBox ItemsSource="{Binding Options.AudioSampleRateChoices}" SelectedItem="{Binding Options.SelectedAudioSampleRate, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="Taxa de amostragem"/>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="7" MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Text="Canais" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
                <ComboBox ItemsSource="{Binding Options.AudioChannelChoices}" SelectedItem="{Binding Options.SelectedAudioChannels, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="280" AutomationProperties.Name="Canais de áudio"/>
              </StackPanel>
            </StackPanel>

            <Border Background="#101A23" CornerRadius="8" Padding="12">
              <TextBlock Text="{Binding Options.Hint}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedForeground}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Salvar como padrão" Command="{Binding SaveOptionsCommand}" AutomationProperties.AutomationId="SaveOptionsButton"/>
              <Button Content="Restaurar ajustes" Command="{Binding ResetOptionsCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding OptionsStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedForeground}"/>
          </StackPanel>
        </Expander>
        <TextBlock Text="{Binding ConversionHint}" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" FontSize="11"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,16,4,0">
      <StackPanel Spacing="10">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Content="Converter arquivo" Command="{Binding ConvertCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="46" FontWeight="SemiBold" AutomationProperties.AutomationId="ConvertButton"/>
          <Button Grid.Column="1" Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding BusyVisibility}" Height="46" Padding="22,8" AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
        <ProgressBar IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Visibility="{Binding BusyVisibility}" Maximum="100" Height="4" AutomationProperties.Name="Progresso da conversão"/>
        <InfoBar IsOpen="True" IsClosable="False" Severity="{Binding Severity}" Title="{Binding Status}" Message="{Binding StatusDetail}"/>
        <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Abrir pasta de destino" Command="{Binding OpenOutputCommand}" Visibility="{Binding OutputVisibility}"/><HyperlinkButton Content="Detalhes técnicos" Command="{Binding DetailsCommand}" Visibility="{Binding DetailsVisibility}"/></StackPanel>
        <TextBlock Text="{Binding DependencyStatus}" FontSize="11" Foreground="{StaticResource MutedForeground}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
