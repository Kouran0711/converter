<UserControl x:Class="NithConverter.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="6"><TextBlock Text="Histórico" Style="{StaticResource PageTitle}"/><TextBlock Text="Suas conversões recentes, guardadas neste computador." TextWrapping="Wrap" Foreground="{StaticResource MutedForeground}"/></StackPanel>
    <Button Grid.Row="1" Content="Limpar histórico" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right"/>
    <Grid Grid.Row="2">
      <ListView ItemsSource="{Binding History}" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Histórico de conversões">
        <ListView.ItemTemplate><DataTemplate>
          <Grid Padding="12,16" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE73E;" Foreground="#75D2A3" FontSize="18" VerticalAlignment="Top" Margin="0,3,0,0"/>
            <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding OutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding InputName}" FontSize="12" Foreground="{StaticResource MutedForeground}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TimestampUtc}" FontSize="11" Foreground="{StaticResource MutedForeground}"/></StackPanel>
          </Grid>
        </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel Visibility="{Binding HistoryEmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"><FontIcon Glyph="&#xE81C;" FontSize="40" Foreground="{StaticResource MutedForeground}"/><TextBlock Text="Seu histórico começa aqui" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="As conversões concluídas aparecerão nesta lista." TextWrapping="Wrap" Foreground="{StaticResource MutedForeground}"/></StackPanel>
    </Grid>
  </Grid>
</UserControl>
